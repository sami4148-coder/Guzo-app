generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRAVELER
  OWNER
  ADMIN

  @@map("user_role")
}

enum HotelStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED

  @@map("hotel_status")
}

enum HotelCategory {
  luxury
  budget
  resort
  guesthouse

  @@map("hotel_category")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @map("password_hash")
  fullName        String   @map("full_name") @db.VarChar(120)
  phone           String?  @db.VarChar(30)
  hotelName       String?  @map("hotel_name") @db.VarChar(150)
  businessAddress String?  @map("business_address") @db.VarChar(255)
  role            UserRole @default(TRAVELER)
  isActive        Boolean  @default(true) @map("is_active")
  ownerStatus     String   @default("APPROVED") @map("owner_status") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Hotel {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String?       @map("owner_id") @db.Uuid
  name           String        @db.VarChar(150)
  city           String        @db.VarChar(100)
  address        String        @db.VarChar(255)
  description    String
  category       HotelCategory @default(luxury)
  basePrice      Int           @map("base_price")
  phone          String?       @db.VarChar(30)
  email          String?       @db.VarChar(255)
  coverImage     String?       @map("cover_image")
  status         HotelStatus   @default(PENDING)
  roomsAvailable Int           @default(1) @map("rooms_available")
  amenities      String[]      @default([])
  otherDetails   String        @default("") @map("other_details")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("hotels")
}

model UserNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  hotelId   String    @map("hotel_id") @db.Uuid
  title     String    @db.VarChar(150)
  message   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_notifications")
}
